# Compiled binaries produced by build.sh
/cocoon
/cocoon.exe

# Generated G-code output
/gcode/

# Browser diagnostic dumps
/about-gpu-*.txt

# Go workspace / test artifacts
*.test
*.out
go.work
go.work.sum

# claude terminal
.bashrc

# Generated by scripts/build-web.sh. Keep them ignored: the GitHub Pages
# deploy (.github/workflows/pages.yml) runs the build itself and publishes
# web/ from the runner, so the repository stays source-only. Committing a
# ~5 MB wasm per build is what grew .git to 163 MB before its history was
# purged.
/web/cocoon.wasm
/web/wasm_exec.js
/web/sw.js

# Copied into web/ by scripts/build-web.sh from the source folders at the
# repository root (profiles/, winds/). Tracking the copies too would mean two
# versions of each sample file, with the copy silently stale until the next
# build.
/web/profiles/
/web/winds/
